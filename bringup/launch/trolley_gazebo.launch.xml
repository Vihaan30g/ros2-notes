<?xml version="1.0"?>
<launch>
    <let name="urdf_path" value="$(find-pkg-share trolley_description)/urdf/trolley_urdf.xacro" />

    <let name="rviz_config_path" value="$(find-pkg-share bringup)/rviz_config/trolley_config.rviz"/>

    <node pkg="robot_state_publisher" exec="robot_state_publisher">
        <param name="robot_description" value="$(command 'xacro $(var urdf_path)')" />
    </node>

    <include file="$(find-pkg-share gazebo_ros)/launch/gazebo.launch.py">
        <arg name="world" value="$(find-pkg-share bringup)/worlds/test_world.world" /> 
    </include>

    <node pkg="gazebo_ros" exec="spawn_entity.py" args="-topic robot_description -entity trolley"/>


    <!--<node pkg="gazebo_ros" exec="spawn_entity.py" output="screen" name="spawn_orange_cone" args="-entity orange_cone -database construction_cone -x 1 -y 0 -z 0" />-->


    <node pkg="rviz2" exec="rviz2" output="screen" args="-d $(var rviz_config_path)" />
    
    
    <!--<node pkg="obstacle_pkg" exec="sister" name="obstacle_node" output="screen"/>-->  <!--obstacle node for 2d lidar-->

    <node pkg="obstacle_pkg" exec="sister2" name="obstacle_node_3d" output="screen"/>     <!--obstacle node for 3d lidar-->


    <!--<node pkg="vision_pkg" exec="OrangeDetector" name="orange_detector_node" output="screen"/>-->           <!--Orange color detection node using openCV-->
    
    <!--<node pkg="yolov5_detector" exec="OrangeCone_node" name="OrangeConeDetectorNode" output="screen"/>-->   <!-- COne detection node using yolov5-->


    <node pkg="orange_cone_detector" exec="yolo_opencv_cone_detect" name="OrangeConeDetectorNode" output="screen"/>

    


 
</launch>
